# Hide ghost HID interfaces on PS5 MediaTek MT7921 BT (USB 0e8d:3603).
# Interfaces 3 and 4 are not real HID endpoints; without this they appear as
# phantom devices and interfere with input routing.
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0e8d", ATTRS{idProduct}=="3603", ATTR{bInterfaceNumber}=="03", ATTR{authorized}="0"
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0e8d", ATTRS{idProduct}=="3603", ATTR{bInterfaceNumber}=="04", ATTR{authorized}="0"

# Force runtime PM "on" for the BT USB device. The MediaTek chip's firmware
# does not resume cleanly from USB-level autosuspend during active HCI; keep
# it powered to avoid DualSense disconnects.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="3603", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="3603", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
